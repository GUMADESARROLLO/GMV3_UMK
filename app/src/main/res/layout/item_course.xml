<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="3dp"
    app:cardCornerRadius="12dp"
    android:clickable="true"
    android:background="?attr/selectableItemBackground"
    app:cardElevation="2dp">

    <LinearLayout
        android:id="@+id/lyt_parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="10dp">
        <!-- Contenedor con imagen y etiqueta superpuesta -->
        <FrameLayout
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginEnd="10dp"
            android:layout_marginRight="10dp">

            <!-- Imagen del curso -->
            <ImageView
                android:id="@+id/category_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@drawable/img_empty_history"
                android:background="@drawable/bg_image_rounded"/>

            <!-- Etiqueta (badge) -->
            <TextView
                android:visibility="gone"
                android:id="@+id/txt_offer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="6dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="FACTURADO"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:background="@drawable/bg_badge"
                android:elevation="2dp" />

            <ImageView
                android:id="@+id/icon_status"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="top|start"
                android:layout_margin="6dp"
                android:padding="4dp"
                android:background="@drawable/bg_badge_icon"
                android:src="@drawable/ic_check_circle" />
        </FrameLayout>

        <!-- Contenedor de texto -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Título -->
            <TextView
                android:id="@+id/product_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="IMIPRAMINA 25 MG TABLETA RECUBIERTA 100/CAJA (INTERMED)"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="15sp"
                android:maxLines="3"
                android:ellipsize="end" />

            <!-- Fila: rating | duración | alumnos -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/id_sku"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:text="SKU. "
                    android:textSize="14sp"
                    android:textAppearance="@style/TextAppearance.AppCompat.Caption"
                    android:textColor="@color/grey_40" />

                <TextView
                    android:id="@+id/id_cod_articulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:text="00000000"
                    android:textSize="14sp"
                    android:textAppearance="@style/TextAppearance.AppCompat.Caption"
                    android:textColor="@color/grey_40"
                    android:textStyle="bold" />


            </LinearLayout>

            <!-- Fila: categoría (izquierda) y precio (derecha) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Categoría -->
                <TextView
                    android:id="@+id/id_Cant_item"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="5,912 [UND]"
                    android:textColor="@color/light_blue_400"
                    android:textStyle="bold"
                    android:textSize="17sp" />

                <!-- Precio -->
                <TextView
                    android:id="@+id/product_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="C$ 144.50"
                    android:textStyle="bold"
                    android:textColor="@color/txt_price_color"
                    android:textSize="17sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
